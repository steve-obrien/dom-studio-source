NODE_ENV=development
HOST=127.0.0.1
PORT=3333

OPENAI_API_KEY=
# Legacy aliases OPEN_AI_API_KEY, OPEN_AI_API, and OPEN_AI_KEY are also accepted, but OPENAI_API_KEY is preferred.
OPENAI_THEME_MODEL=gpt-4.1-mini
THEME_AI_ALLOWED_ORIGINS=http://localhost:3333,https://getdom.studio
THEME_AI_PUBLIC_TOKEN=
VITE_THEME_AI_ENDPOINT=/api/ai/theme
VITE_THEME_AI_PUBLIC_TOKEN=

AUTH_SECRET=
AUTH_ACCESS_CODE=
AUTH_SESSION_MAX_AGE=2592000
STRIPE_PAYMENT_LINK=
STRIPE_INDIVIDUAL_PAYMENT_LINK=
STRIPE_TEAM_PAYMENT_LINK=
VITE_STRIPE_PAYMENT_LINK=
STRIPE_INDIVIDUAL_PROMOTION_CODE=
STRIPE_TEAM_PROMOTION_CODE=
BILLING_INDIVIDUAL_PRICE=149
BILLING_INDIVIDUAL_SALE_PRICE=
BILLING_INDIVIDUAL_OFFER_LABEL=
BILLING_TEAM_PRICE=499
BILLING_TEAM_SALE_PRICE=
BILLING_TEAM_OFFER_LABEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OUTRANK_WEBHOOK_ACCESS_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=getdom_studio

# Local-only development helper: npm run db:import:production -- --yes
# Production DB credentials are read from this SSH target/IP.
PRODUCTION_DB_SERVER_HOST=
PRODUCTION_DB_ENV_PATH=/opt/getdom.studio/shared/.env
