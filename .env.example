NODE_ENV=development
HOST=127.0.0.1
PORT=8100

OPENAI_API_KEY=
# Legacy aliases OPEN_AI_API_KEY, OPEN_AI_API, and OPEN_AI_KEY are also accepted, but OPENAI_API_KEY is preferred.
OPENAI_THEME_MODEL=gpt-4.1-mini
# Model for scripts/generate-social-templates.mjs (npm run templates:social).
OPENAI_TEMPLATE_MODEL=gpt-4.1
THEME_AI_ALLOWED_ORIGINS=https://local.getdom.studio,http://localhost:8100,http://localhost:8102,http://localhost:8110,https://getdom.studio
THEME_AI_PUBLIC_TOKEN=
VITE_THEME_AI_ENDPOINT=/api/ai/theme
VITE_THEME_AI_PUBLIC_TOKEN=
VITE_GA_MEASUREMENT_ID=G-RHFEKPJ8PH

AUTH_SECRET=
AUTH_ACCESS_CODE=
AUTH_SESSION_MAX_AGE=2592000

# USD prices: introductory $99 / $299; regular $149 / $499.
# Switch both the website and checkout together by setting this to regular.
BILLING_PRICING_PHASE=introductory
# Stripe plink_ IDs, with metadata.dom_studio_licence set to individual or team.
# Legacy GBP links and promotion codes are deliberately not used for new checkout.
STRIPE_INDIVIDUAL_USD_INTRO_PAYMENT_LINK_ID=
STRIPE_TEAM_USD_INTRO_PAYMENT_LINK_ID=
STRIPE_INDIVIDUAL_USD_PAYMENT_LINK_ID=
STRIPE_TEAM_USD_PAYMENT_LINK_ID=
# Retain older sold Payment Link IDs for delayed events and historic reconciliation.
STRIPE_LEGACY_PAYMENT_LINK_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Guest checkout requires a configured transactional email sender and matching return URL.
# In local development use the exact browser origin, e.g. http://localhost:8110.
BILLING_PUBLIC_URL=https://getdom.studio
RESEND_API_KEY=
LICENCE_EMAIL_FROM=DOM Studio <licences@example.com>
# Exact reverse-proxy IPs allowed to supply X-Forwarded-For for email rate limits.
# Set only for your controlled proxy, e.g. 127.0.0.1,::1 behind local Caddy.
BILLING_TRUST_PROXY_IPS=
OUTRANK_WEBHOOK_ACCESS_TOKEN=

# Optional override for the workflow-synchronized public release snapshot.
RELEASES_FILE=
# Optional legacy server-only token: read Contents on steve-obrien/dom.studio.
# Production uses the synchronized file. Never prefix the token with VITE_.
RELEASES_GITHUB_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=getdom_studio

# Local-only development helper: npm run db:import:production -- --yes
# Production DB credentials are read from this SSH target/IP.
PRODUCTION_DB_SERVER_HOST=
PRODUCTION_DB_ENV_PATH=/opt/getdom.studio/shared/.env
