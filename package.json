{
	"name": "@getdom/studio",
	"version": "0.1.0",
	"description": "DOM Studio is a complete Vue and Web Component UI system you can own, edit, and ship.",
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"src/pages/lib/headless/*.js"
	],
	"types": "./src/pages/lib/vue/index.d.ts",
	"scripts": {
		"dev": "npm run catalog:generate && npm run seo:generate && node server.js",
		"build": "npm run catalog:generate && npm run build:client && npm run build:server && npm run seo:generate",
		"build:client": "vite build --outDir dist/client --ssrManifest",
		"build:server": "vite build --outDir dist/server --ssr src/entry-server.js",
		"catalog:generate": "node scripts/generate-component-catalog.mjs",
		"seo:generate": "node scripts/generate-seo-files.mjs",
		"types:generate": "node scripts/generate-types.mjs",
		"prepack": "npm run catalog:generate && npm run types:generate",
		"check:form-definition": "node scripts/check-form-definition.mjs",
		"check:theme-ai": "node scripts/check-theme-ai-endpoint.mjs",
		"db:migrate": "knex migrate:latest",
		"db:import:production": "node scripts/import-production-db.mjs",
		"db:rollback": "knex migrate:rollback",
		"now:test": "npm --prefix packages/now test",
		"preview": "NODE_ENV=production node server.js",
		"dev:screenshot": "HOST=127.0.0.1 PORT=3342 npm run dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steve-obrien/dom.studio.git"
	},
	"keywords": [
		"vue",
		"web-components",
		"custom-elements",
		"component-library",
		"design-system",
		"llm-ui"
	],
	"author": "Steve O'Brien",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/steve-obrien/dom.studio/issues"
	},
	"homepage": "https://getdom.studio",
	"dependencies": {
		"@tiptap/extension-collaboration": "^3.27.3",
		"@tiptap/extension-collaboration-caret": "^3.27.3",
		"@tiptap/extension-image": "^3.27.3",
		"@tiptap/extension-link": "^3.27.3",
		"@tiptap/extension-placeholder": "^3.27.3",
		"@tiptap/extension-underline": "^3.27.3",
		"@tiptap/starter-kit": "^3.27.3",
		"@tiptap/vue-3": "^3.27.3",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"compression": "^1.8.1",
		"dotenv": "^16.6.1",
		"express": "^4.22.2",
		"knex": "^3.2.10",
		"markdown-it": "^14.2.0",
		"monaco-editor": "^0.55.1",
		"mysql2": "^3.22.5",
		"pinia": "^2.3.1",
		"stripe": "^22.2.0",
		"tailwindcss": "^4.2.4",
		"vue": "^3.5.33",
		"vue-router": "^4.6.4",
		"yjs": "^13.6.31"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@vue/compiler-sfc": "^3.5.33",
		"@vitejs/plugin-vue": "^6.0.6",
		"vite": "^8.0.10"
	},
	"typesVersions": {
		"*": {
			"vue": [
				"src/pages/lib/vue/index.d.ts"
			],
			"headless": [
				"src/pages/lib/headless/index.d.ts"
			],
			"headless/*.js": [
				"src/pages/lib/headless/*.d.ts"
			],
			"headless/*": [
				"src/pages/lib/headless/*.d.ts"
			]
		}
	},
	"files": [
		"README.md",
		"LICENSE.md",
		"SKILL.md",
		"public/llms.txt",
		"public/skills.sh",
		"src/pages/_layout",
		"src/pages/components",
		"src/pages/data",
		"src/pages/dev",
		"src/pages/forms",
		"src/pages/lib",
		"src/pages/mobile",
		"src/pages/visual",
		"src/style.css"
	],
	"exports": {
		".": {
			"types": "./src/pages/lib/vue/index.d.ts",
			"import": "./src/pages/lib/vue/index.js"
		},
		"./vue": {
			"types": "./src/pages/lib/vue/index.d.ts",
			"import": "./src/pages/lib/vue/index.js"
		},
		"./headless": {
			"types": "./src/pages/lib/headless/index.d.ts",
			"import": "./src/pages/lib/headless/index.js"
		},
		"./headless/*.js": {
			"types": "./src/pages/lib/headless/*.d.ts",
			"import": "./src/pages/lib/headless/*.js"
		},
		"./headless/*": {
			"types": "./src/pages/lib/headless/*.d.ts",
			"import": "./src/pages/lib/headless/*.js"
		},
		"./style.css": "./src/style.css",
		"./llms.txt": "./public/llms.txt",
		"./skill": "./SKILL.md",
		"./skills.sh": "./public/skills.sh"
	}
}
