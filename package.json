{
	"name": "@getdom/studio",
	"version": "0.1.0",
	"description": "DOM Studio is a source-owned Vue and web component interface system for humans and LLMs.",
	"type": "module",
	"scripts": {
		"dev": "node server.js",
		"build": "npm run build:client && npm run build:server && node scripts/generate-seo-files.mjs",
		"build:client": "vite build --outDir dist/client --ssrManifest",
		"build:server": "vite build --outDir dist/server --ssr src/entry-server.js",
		"check:form-definition": "node scripts/check-form-definition.mjs",
		"check:theme-ai": "node scripts/check-theme-ai-endpoint.mjs",
		"db:migrate": "knex migrate:latest",
		"db:rollback": "knex migrate:rollback",
		"now:test": "npm --prefix packages/now test",
		"theme-ai-server": "node scripts/theme-ai-server.mjs",
		"preview": "NODE_ENV=production node server.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steve-obrien/dom.studio.git"
	},
	"keywords": [
		"vue",
		"web-components",
		"custom-elements",
		"component-library",
		"design-system",
		"llm-ui"
	],
	"author": "Steve O'Brien",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/steve-obrien/dom.studio/issues"
	},
	"homepage": "https://getdom.studio",
	"dependencies": {
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"compression": "^1.8.1",
		"dotenv": "^16.6.1",
		"express": "^4.22.2",
		"knex": "^3.2.10",
		"markdown-it": "^14.2.0",
		"monaco-editor": "^0.55.1",
		"mysql2": "^3.22.5",
		"pinia": "^2.3.1",
		"stripe": "^22.2.0",
		"tailwindcss": "^4.2.4",
		"vue": "^3.5.33",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@vitejs/plugin-vue": "^6.0.6",
		"vite": "^8.0.10"
	},
	"files": [
		"README.md",
		"LICENSE.md",
		"SKILL.md",
		"public/llms.txt",
		"public/skills.sh",
		"src/pages/_layout",
		"src/pages/components",
		"src/pages/forms",
		"src/pages/lib",
		"src/pages/mobile",
		"src/pages/visual",
		"src/style.css"
	],
	"exports": {
		".": "./src/pages/lib/vue/index.js",
		"./vue": "./src/pages/lib/vue/index.js",
		"./headless": "./src/pages/lib/headless/index.js",
		"./headless/*": "./src/pages/lib/headless/*",
		"./style.css": "./src/style.css",
		"./llms.txt": "./public/llms.txt",
		"./skill": "./SKILL.md"
	}
}
